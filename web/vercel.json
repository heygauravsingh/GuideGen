{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/g/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebookcatalog|whatsapp|slackbot|slack-imgproxy|twitterbot|linkedinbot|telegrambot|discordbot|redditbot|pinterest|skypeuripreview|embedly|iframely|quora link preview|vkshare|applebot|bingbot|googlebot|google-inspectiontool|mastodon|bitlybot|flipboard|tumblr|yandex|duckduckbot|preview).*"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/g/:id",
      "destination": "/g"
    },
    {
      "source": "/h/:uid",
      "destination": "/h"
    }
  ],
  "headers": [
    {
      "source": "/g/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/h/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/inbox",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    }
  ]
}
