{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/g/:id", "destination": "/g.html" }
  ],
  "headers": [
    {
      "source": "/g/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/app",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
