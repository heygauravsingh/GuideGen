# macOS
.DS_Store
._*

# Claude Code local settings — machine-specific, not shared
.claude/settings.local.json

# Build output (regenerated by store/RUNBOOK.md step 2)
*.zip

# Store screenshot working folders — the originals aren't worth versioning
store/screenshots-raw/*
!store/screenshots-raw/.gitkeep
# generated store screenshots ARE worth versioning — they're the listing assets
!store/screenshots-out/*.png
