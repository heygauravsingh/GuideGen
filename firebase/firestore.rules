rules_version = '2';

// FlowScribe — Firestore security rules.
//
// This file IS the authorization model. There is no server-side code checking
// permissions; if a rule here is wrong, the data is exposed. Anything not
// matched below is denied by default.
//
// Paste into: Firebase console -> Firestore Database -> Rules -> Publish

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Guides -------------------------------------------------------------
    // The document ID is the public share slug: /g/{guideId}
    match /guides/{guideId} {

      // Readable by anyone only once the owner has explicitly published it.
      // The owner can always read their own guides, published or not.
      allow read: if resource.data.visibility == 'link'
                  || (request.auth != null
                      && request.auth.uid == resource.data.ownerUid);

      // Creating: you must be signed in, you must name yourself as the owner,
      // and you cannot create something already public beyond 'link'.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.visibility in ['private', 'link']
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 300
                    && request.resource.data.steps is list
                    && request.resource.data.steps.size() <= 300;

      // Updating: owner only, and ownership can never be reassigned to
      // someone else — that check is what stops a guide being stolen.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.visibility in ['private', 'link']
                    && request.resource.data.steps is list
                    && request.resource.data.steps.size() <= 300;

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;

      // ---- Export log -------------------------------------------------------
      // One document per export a *recipient* performs from the public page.
      // This is the only place a non-owner writes anything, so it is the only
      // place a stranger's input reaches storage. Four things make that safe:
      //
      //  1. `uid` must be the caller's own. Taken from the token, not the body.
      //  2. `email` must equal the token's email. Without this a recipient could
      //     log an export as anyone they liked, which is worse than no log —
      //     the owner would be reading fabricated names.
      //  3. There is no client timestamp. The time comes from the document's
      //     createTime, which the server sets and no client can forge. Do not
      //     add an `at` field; it would be a lie waiting to happen.
      //  4. Only readable by the guide's owner, and only creatable while the
      //     owner still has exports switched on.
      match /exports/{exportId} {
        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['uid', 'email', 'kind'])
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.email == request.auth.token.email
                      // Whitelisted, so a new export format needs a line here AND a
                      // rules deploy. 'ai' is the handoff copy — logged like any
                      // other export, because from the owner's side it is one: the
                      // guide's text left with a named recipient.
                      && request.resource.data.kind in ['html', 'markdown', 'pdf', 'pptx', 'video', 'ai']
                      && get(/databases/$(database)/documents/guides/$(guideId)).data.allowExport == true;

        allow read: if request.auth != null
                    && request.auth.uid ==
                       get(/databases/$(database)/documents/guides/$(guideId)).data.ownerUid;

        // Append-only for recipients: nobody edits a log entry, ever. The owner
        // can delete — it holds other people's email addresses, so they must be
        // able to clear it, and deleting the guide clears it too (the
        // /api/delete-assets endpoint sweeps the subcollection, because
        // Firestore does not cascade).
        allow update: if false;
        allow delete: if request.auth != null
                      && request.auth.uid ==
                         get(/databases/$(database)/documents/guides/$(guideId)).data.ownerUid;
      }
    }

    // ---- User profiles ------------------------------------------------------
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Waitlist -----------------------------------------------------------
    // Write-only drop box. Nobody can read it back, including via the client,
    // so a scraped API key can't harvest the email list.
    // ---- Waitlist, votes, hellos and competition entries --------------------
    // One collection for every form in the house: the email box, the "build this
    // next" votes, the Say Hi messages and the Make it rain answers. `note`
    // carries a prefix (`vote:`, `hi:`, `rain:`) so they can be told apart, and
    // that is why there is no second collection to write rules for.
    //
    // Anyone may create; nobody may edit or delete; only the owner may read.
    // Every size limit below is enforced HERE and nowhere else that matters — the
    // forms truncate before sending, but a client can be bypassed with one curl,
    // so a missing cap here is a cap that does not exist. `note` had no limit
    // until 4 Aug 2026, which meant a megabyte of text was a legal submission.
    match /waitlist/{docId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 600
                    && request.resource.data.keys().hasOnly(['email', 'note', 'createdAt', 'shots'])
                    // `shots` is optional: up to three image URLs from a Say Hi
                    // message. Length-capped so the field cannot become a payload.
                    && (!request.resource.data.keys().hasAny(['shots'])
                        || (request.resource.data.shots is list
                            && request.resource.data.shots.size() <= 3));

      // Read is for the owner's inbox at /inbox, and for nobody else. Matched on
      // the token's verified email rather than a uid, because a uid is invisible
      // in the console and impossible to check by eye.
      //
      // KEEP ONLY THE ADDRESS GAURAV ACTUALLY SIGNS IN WITH. Both are here
      // because both appear in this project and the choice is his, not mine.
      allow read: if request.auth != null
                  && request.auth.token.email in [
                       'heygauravsingh@gmail.com'
                     ];

      allow update, delete: if false;
    }

    // Everything else: denied (implicit, but stated for the next reader).
  }
}
